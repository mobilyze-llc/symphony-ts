# Slack bot credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Channel ID → project directory mapping (JSON object)
# Example: {"C0123456789":"/home/user/projects/my-app","C9876543210":"/home/user/projects/other-app"}
CHANNEL_PROJECT_MAP={}

# Claude Code model identifier (optional, defaults to "sonnet")
# Valid values: sonnet, opus, haiku
CLAUDE_MODEL=sonnet

# Durable Crucible checkout used by LaunchAgent-backed planner/review execution
SYMPHONY_CRABRUNNER_ROOT=/path/to/crucible/controller

# Crabrunner lane host for planner/review execution (SYMPH-1144). Selects where
# crabrunner lanes run; unset/blank runs them locally. Production pins this to
# pro16. Keep it in the durable SOPS env source (.env.enc) so it survives host
# moves — an operator-shell-only value disappears when the LaunchAgent restarts.
# The resolved host is logged at startup and stamped on every planner tick record.
SYMPHONY_CRABRUNNER_HOST=pro16
