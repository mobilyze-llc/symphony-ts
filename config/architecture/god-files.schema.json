{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symphony.local/architecture/god-files.schema.json",
  "title": "Architecture god-file pins",
  "type": "object",
  "required": ["$schema", "schema", "pinned_files", "waivers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "symphony.architecture.god-files.v1" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pinned_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pinned_file" }
    },
    "waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" }
    }
  },
  "$defs": {
    "pinned_file": {
      "type": "object",
      "required": ["path", "max_lines", "forbidden_new_patterns"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "max_lines": { "type": "integer", "minimum": 1 },
        "forbidden_new_patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/forbidden_pattern" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "forbidden_pattern": {
      "type": "object",
      "required": ["id", "pattern", "remediation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "pattern": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "waiver": {
      "type": "object",
      "required": ["path", "rule", "reason", "expires"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
