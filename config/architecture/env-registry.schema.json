{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symphony.local/architecture/env-registry.schema.json",
  "title": "Named environment read registry",
  "type": "object",
  "required": ["$schema", "schema", "reads"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "symphony.architecture.env-registry.v1" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "read_sites"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "read_sites": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
