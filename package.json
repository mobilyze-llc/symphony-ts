{
  "name": "symphony-ts",
  "version": "2026.03.23.1",
  "license": "Apache-2.0",
  "type": "module",
  "description": "TypeScript implementation of Symphony",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "symphony": "./dist/src/cli/main.js",
    "symphony-calibration-digest": "./dist/src/calibration/cli.js",
    "symphony-council-review-gate": "./dist/src/cli/council-review-gate.js",
    "symphony-manager-run-import": "./dist/src/cli/manager-run-import.js"
  },
  "files": ["dist/src", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OasAIStudio/symphony-ts.git"
  },
  "bugs": {
    "url": "https://github.com/OasAIStudio/symphony-ts/issues"
  },
  "homepage": "https://github.com/OasAIStudio/symphony-ts#readme",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "probe:codex-skills": "node scripts/probe-codex-skills.mjs",
    "smoke:codex-headless": "node scripts/probe-codex-skills.mjs --ci-smoke",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "^29.0.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/provider": "^3.0.8",
    "@google/gemini-cli-core": "^0.33.2",
    "@google/genai": "^1.45.0",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.15.0",
    "ai": "^6.0.116",
    "ai-sdk-provider-claude-code": "^3.4.4",
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "graphql": "^16.13.1",
    "liquidjs": "^10.27.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/claude-agent-sdk": "0.2.90",
      "@hono/node-server@1": "^1.19.13",
      "@protobufjs/utf8@1": "^1.1.1",
      "@tootallnate/once@2": "^2.0.1",
      "axios@1": "^1.16.0",
      "brace-expansion@5": "^5.0.6",
      "fast-uri@3": "^3.1.2",
      "follow-redirects@1": "^1.16.0",
      "hono@4": "^4.12.21",
      "ip-address@10": "^10.1.1",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@4": "^4.0.4",
      "postcss@8": "^8.5.10",
      "protobufjs@7": "^7.5.8",
      "protobufjs@8": "^8.2.0",
      "qs@6": "^6.15.2",
      "shell-quote@1": "^1.8.4",
      "simple-git@3": "^3.36.0",
      "systeminformation@5": "^5.31.6",
      "uuid@11": "^11.1.1",
      "uuid@13": "^13.0.1",
      "vite@7": "^7.3.2",
      "ws@8": "^8.20.1"
    }
  }
}
