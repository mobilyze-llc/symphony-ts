#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RUNBOOK="$REPO_ROOT/docs/operations/cmux-review-substrate-deploy.md"
REMOTE_HOST="${CMUX_REVIEW_PRIMARY_HOST:-clawdilize@pro16.local}"
LOCAL_CRUCIBLE="${LOCAL_CRUCIBLE:-$HOME/projects/crucible}"
REMOTE_SYMPHONY="${REMOTE_SYMPHONY:-~/projects/symphony-ts}"
REMOTE_CRUCIBLE="${REMOTE_CRUCIBLE:-~/projects/crucible}"
EXPECTED_REMOTE_REF="${CMUX_REVIEW_EXPECTED_REMOTE_REF:-origin/main}"
EXPECTED_REMOTE_BRANCH="${CMUX_REVIEW_EXPECTED_REMOTE_BRANCH:-main}"
SSH_BIN="${CMUX_REVIEW_SSH_BIN:-ssh}"
ARTIFACT_DIR=""
NO_REMOTE=false
ALLOW_DRIFT=false
FAILURES=()
FAILURE_COUNT=0

usage() {
  cat <<EOF
cmux-review-substrate-deploy — inspect/prove the Pro16 CMUX review substrate

Usage: ops/cmux-review-substrate-deploy [flags]

Flags:
  --artifact-dir <dir>  Evidence directory to write.
                        Default: /tmp/cmux-review-substrate-deploy-<timestamp>
  --remote-host <host>  Remote primary host (default: ${REMOTE_HOST})
  --no-remote           Skip SSH and remote preflight; useful for CI/tests
  --allow-drift         Write evidence but exit 0 even when gates fail
  -h, --help            Show this help

This helper implements ${RUNBOOK}. It is intentionally conservative: it writes
an evidence bundle, audits raw local cmux-spawn callers, probes Pro16 when not
disabled, and does not mutate local or remote checkouts.

Lightweight review rule:
  For deploy/runbook/helper changes, run tests, run this helper, then run one
  Kimi review lane over the diff and evidence. Fix meaningful correctness,
  safety, deploy, provenance, rollback, or usability findings; ignore nits.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --artifact-dir)
      [[ $# -ge 2 ]] || { echo "--artifact-dir requires a value" >&2; exit 2; }
      ARTIFACT_DIR="$2"
      shift 2
      ;;
    --remote-host)
      [[ $# -ge 2 ]] || { echo "--remote-host requires a value" >&2; exit 2; }
      REMOTE_HOST="$2"
      shift 2
      ;;
    --no-remote)
      NO_REMOTE=true
      shift
      ;;
    --allow-drift)
      ALLOW_DRIFT=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$ARTIFACT_DIR" ]]; then
  ARTIFACT_DIR="/tmp/cmux-review-substrate-deploy-$(date -u +%Y%m%dT%H%M%SZ)"
fi

mkdir -p "$ARTIFACT_DIR"

run_capture() {
  local stem="$1"
  shift
  set +e
  "$@" >"$ARTIFACT_DIR/${stem}.stdout" 2>"$ARTIFACT_DIR/${stem}.stderr"
  local rc=$?
  set -e
  printf '%s\n' "$rc" >"$ARTIFACT_DIR/${stem}.exit"
  return 0
}

run_shell_capture() {
  local stem="$1"
  local script="$2"
  set +e
  bash -lc "$script" >"$ARTIFACT_DIR/${stem}.stdout" 2>"$ARTIFACT_DIR/${stem}.stderr"
  local rc=$?
  set -e
  printf '%s\n' "$rc" >"$ARTIFACT_DIR/${stem}.exit"
  return 0
}

run_remote_capture() {
  local stem="$1"
  local script="$2"
  set +e
  "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=8 "$REMOTE_HOST" "$script" \
    >"$ARTIFACT_DIR/${stem}.stdout" \
    2>"$ARTIFACT_DIR/${stem}.stderr"
  local rc=$?
  set -e
  printf '%s\n' "$rc" >"$ARTIFACT_DIR/${stem}.exit"
  return 0
}

record_failure() {
  FAILURES+=("$1")
  FAILURE_COUNT=$((FAILURE_COUNT + 1))
}

require_exit_zero() {
  local stem="$1"
  local label="$2"
  local exit_file="$ARTIFACT_DIR/${stem}.exit"
  [[ -f "$exit_file" ]] || {
    record_failure "$label: missing exit file $exit_file"
    return 0
  }
  local rc
  rc="$(tr -d '[:space:]' <"$exit_file")"
  [[ "$rc" == "0" ]] || record_failure "$label: exited $rc"
}

repo_snapshot() {
  local label="$1"
  local path="$2"
  if [[ ! -d "$path/.git" && ! -d "$path" ]]; then
    printf 'missing path: %s\n' "$path"
    return 0
  fi
  if ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'not a git repository: %s\n' "$path"
    return 0
  fi
  printf '# %s\n' "$label"
  printf 'path=%s\n' "$path"
  printf 'head='
  git -C "$path" rev-parse HEAD 2>/dev/null || true
  printf 'branch='
  git -C "$path" branch --show-current 2>/dev/null || true
  printf 'status:\n'
  git -C "$path" status --short --branch 2>/dev/null || true
}

write_metadata() {
  {
    printf 'schema=mobilyze.cmux-review-substrate-deploy.v1\n'
    printf 'created_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'cwd=%s\n' "$PWD"
    printf 'repo_root=%s\n' "$REPO_ROOT"
    printf 'runbook=%s\n' "$RUNBOOK"
    printf 'remote_host=%s\n' "$REMOTE_HOST"
    printf 'expected_remote_ref=%s\n' "$EXPECTED_REMOTE_REF"
    printf 'expected_remote_branch=%s\n' "$EXPECTED_REMOTE_BRANCH"
    printf 'effective_runtime_root=%s\n' "$(effective_runtime_root)"
    printf 'route_tier=%s\n' "$(route_tier)"
    printf 'codex_thread_id=%s\n' "${CODEX_THREAD_ID:-}"
    printf 'no_remote=%s\n' "$NO_REMOTE"
    printf 'allow_drift=%s\n' "$ALLOW_DRIFT"
    printf 'failure_count=%s\n' "$FAILURE_COUNT"
  } >"$ARTIFACT_DIR/metadata.env"
}

route_tier() {
  if ((FAILURE_COUNT > 0)); then
    printf 'failed-closed'
  elif [[ "$NO_REMOTE" == "true" ]]; then
    printf 'forced-local-pro14'
  else
    printf 'remote-pro16'
  fi
}

effective_runtime_root() {
  if [[ "$NO_REMOTE" == "true" ]]; then
    printf '%s' "$LOCAL_CRUCIBLE"
  else
    printf '%s:%s' "$REMOTE_HOST" "$REMOTE_CRUCIBLE"
  fi
}

caller_audit() {
  local roots_raw="${CMUX_DEPLOY_AUDIT_ROOTS:-$REPO_ROOT/skills:$REPO_ROOT/src:$REPO_ROOT/ops:$HOME/.agents/skills:$HOME/.codex/skills:$HOME/projects/claude-config/skills}"
  local pattern='/Users/ericlitman/projects/crucible/bin/cmux-spawn([^[:alnum:]_-]|$)|\$HOME/projects/crucible/bin/cmux-spawn([^[:alnum:]_-]|$)|command -v cmux-spawn([^[:alnum:]_-]|$)|CMUX_SPAWN_BIN=.*cmux-spawn([^[:alnum:]_-]|$)'
  local out="$ARTIFACT_DIR/caller-audit.txt"
  : >"$out"
  IFS=':' read -r -a roots <<<"$roots_raw"
  for root in "${roots[@]}"; do
    [[ -d "$root" ]] || continue
    {
      printf '## root: %s\n' "$root"
      if command -v rg >/dev/null 2>&1; then
        rg -n --hidden --glob '!node_modules/**' --glob '!dist/**' \
          "$pattern" \
          "$root" || true
      else
        grep -RInE --exclude-dir=node_modules --exclude-dir=dist "$pattern" \
          "$root" || true
      fi
      printf '\n'
    } >>"$out"
  done
}

write_local_evidence() {
  repo_snapshot "local symphony" "$REPO_ROOT" >"$ARTIFACT_DIR/local-symphony.txt"
  repo_snapshot "local crucible" "$LOCAL_CRUCIBLE" >"$ARTIFACT_DIR/local-crucible.txt"
  run_capture local-cmux-spawn-path bash -lc 'command -v cmux-spawn || true; ls -l ~/.local/bin/cmux-spawn 2>/dev/null || true'
  run_capture local-monitor-state bash -lc 'test -f ~/.cmux-spawn/substrate-monitor.json && python3 -m json.tool ~/.cmux-spawn/substrate-monitor.json || true'
  run_capture local-cmux-workspaces bash -lc 'cmux --id-format both list-workspaces 2>/dev/null || true'
  caller_audit
}

write_remote_evidence() {
  if [[ "$NO_REMOTE" == "true" ]]; then
    printf 'remote probe skipped by --no-remote\n' >"$ARTIFACT_DIR/remote-skipped.txt"
    return 0
  fi

  run_remote_capture remote-symphony "cd $REMOTE_SYMPHONY && git status --short --branch && git log -1 --oneline --decorate --date=iso --format=\"%h %cd %d %s\" && git rev-parse origin/main 2>/dev/null || true"
  run_remote_capture remote-crucible "cd $REMOTE_CRUCIBLE && git status --short --branch && git log -1 --oneline --decorate --date=iso --format=\"%h %cd %d %s\" && git rev-parse origin/main 2>/dev/null || true"
  run_remote_capture remote-cmux-workspaces "cmux --version || true; cmux --id-format both list-workspaces 2>/dev/null || true"
  run_remote_capture remote-cmux-spawn-help "$REMOTE_CRUCIBLE/bin/cmux-spawn run --help 2>&1 | sed -n \"1,120p\""
  run_remote_capture remote-monitor-state "launchctl list 2>/dev/null | grep -E \"cmux|mobilyze\" || true; test -f ~/.cmux-spawn/substrate-monitor.json && python3 -m json.tool ~/.cmux-spawn/substrate-monitor.json || true"
  write_remote_checkout_gates

  local remote_shim="$LOCAL_CRUCIBLE/bin/cmux-spawn-remote"
  if [[ -x "$remote_shim" ]]; then
    set +e
    CMUX_SPAWN_REMOTE_HOST="$REMOTE_HOST" "$remote_shim" preflight --json \
      >"$ARTIFACT_DIR/remote-preflight.json" \
      2>"$ARTIFACT_DIR/remote-preflight.stderr"
    local rc=$?
    set -e
    printf '%s\n' "$rc" >"$ARTIFACT_DIR/remote-preflight.exit"
  else
    printf 'missing executable: %s\n' "$remote_shim" >"$ARTIFACT_DIR/remote-preflight.stderr"
    printf '127\n' >"$ARTIFACT_DIR/remote-preflight.exit"
  fi
}

write_remote_checkout_gates() {
  local script
  script='
set -euo pipefail
check_checkout() {
  local label="$1"
  local path="$2"
  local expected_ref="$3"
  local expected_branch="$4"
  path="${path/#\~/$HOME}"
  if ! cd "$path" 2>/dev/null; then
    printf "%s\t%s\tmissing\tmissing\t%s\tmissing\t%s\tmissing\tfalse\tfail\n" "$label" "$path" "$expected_branch" "$expected_ref"
    return 0
  fi
  local head branch tracked_dirty expected_sha contains_expected status
  head="$(git rev-parse HEAD 2>/dev/null || printf missing)"
  branch="$(git branch --show-current 2>/dev/null || true)"
  tracked_dirty="$(git status --short --untracked-files=no 2>/dev/null | wc -l | tr -d "[:space:]")"
  expected_sha="$(git rev-parse "$expected_ref" 2>/dev/null || printf unresolved)"
  contains_expected=false
  if [[ "$expected_sha" != "unresolved" ]] && git merge-base --is-ancestor "$expected_sha" HEAD 2>/dev/null; then
    contains_expected=true
  fi
  status=pass
  [[ "$branch" == "$expected_branch" ]] || status=fail
  [[ "$tracked_dirty" == "0" ]] || status=fail
  [[ "$contains_expected" == "true" ]] || status=fail
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$label" "$path" "$head" "${branch:-DETACHED}" "$expected_branch" "$tracked_dirty" "$expected_ref" "$expected_sha" "$contains_expected" "$status"
}
check_checkout symphony "$REMOTE_SYMPHONY" "$EXPECTED_REMOTE_REF" "$EXPECTED_REMOTE_BRANCH"
check_checkout crucible "$REMOTE_CRUCIBLE" "$EXPECTED_REMOTE_REF" "$EXPECTED_REMOTE_BRANCH"
'
  set +e
  REMOTE_SYMPHONY="$REMOTE_SYMPHONY" \
    REMOTE_CRUCIBLE="$REMOTE_CRUCIBLE" \
    EXPECTED_REMOTE_REF="$EXPECTED_REMOTE_REF" \
    EXPECTED_REMOTE_BRANCH="$EXPECTED_REMOTE_BRANCH" \
    "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=8 "$REMOTE_HOST" \
    "REMOTE_SYMPHONY='$REMOTE_SYMPHONY' REMOTE_CRUCIBLE='$REMOTE_CRUCIBLE' EXPECTED_REMOTE_REF='$EXPECTED_REMOTE_REF' EXPECTED_REMOTE_BRANCH='$EXPECTED_REMOTE_BRANCH' bash -s" \
    >"$ARTIFACT_DIR/remote-checkout-gates.tsv" \
    2>"$ARTIFACT_DIR/remote-checkout-gates.stderr" <<<"$script"
  local rc=$?
  set -e
  printf '%s\n' "$rc" >"$ARTIFACT_DIR/remote-checkout-gates.exit"
}

evaluate_gates() {
  if [[ "$NO_REMOTE" == "true" ]]; then
    return 0
  fi

  require_exit_zero remote-preflight "remote preflight"
  require_exit_zero remote-checkout-gates "remote checkout gate probe"

  if [[ -f "$ARTIFACT_DIR/remote-checkout-gates.tsv" ]]; then
    while IFS=$'\t' read -r label path head branch expected_branch tracked_dirty expected_ref expected_sha contains_expected status; do
      [[ -n "${label:-}" ]] || continue
      [[ "$status" == "pass" ]] || {
        record_failure "remote $label checkout gate failed: path=$path head=$head branch=$branch expected_branch=$expected_branch tracked_dirty=$tracked_dirty expected_ref=$expected_ref expected_sha=$expected_sha contains_expected=$contains_expected"
      }
    done <"$ARTIFACT_DIR/remote-checkout-gates.tsv"
  fi

  if [[ -f "$ARTIFACT_DIR/remote-cmux-spawn-help.stdout" ]] &&
    ! grep -Eq -- "--agent.*kimi" "$ARTIFACT_DIR/remote-cmux-spawn-help.stdout"; then
    record_failure "remote cmux-spawn help does not advertise the kimi agent"
  fi
}

write_failures() {
  : >"$ARTIFACT_DIR/gate-failures.txt"
  if ((FAILURE_COUNT > 0)); then
    for failure in "${FAILURES[@]}"; do
      printf '%s\n' "$failure" >>"$ARTIFACT_DIR/gate-failures.txt"
    done
  fi
}

write_summary() {
  {
    printf '# CMUX Review Substrate Deploy Evidence\n\n'
    printf '%s\n' "- Artifact dir: \`$ARTIFACT_DIR\`"
    printf '%s\n' "- Route tier: \`$(route_tier)\`"
    printf '%s\n' "- Runbook: \`$RUNBOOK\`"
    printf '%s\n' "- Remote host: \`$REMOTE_HOST\`"
    printf '%s\n' "- Expected remote ref: \`$EXPECTED_REMOTE_REF\`"
    printf '%s\n' "- Expected remote branch: \`$EXPECTED_REMOTE_BRANCH\`"
    printf '%s\n' "- Effective runtime root: \`$(effective_runtime_root)\`"
    printf '%s\n' "- Gate failures: \`$FAILURE_COUNT\`"
    printf '\n## Required Follow-up Checks\n\n'
    printf '%s\n' '- Confirm default Pro16 deploy checkouts are on intended merged refs.'
    printf '%s\n' '- Classify every `caller-audit.txt` hit before closeout.'
    printf '%s\n' '- Attach Kimi lightweight review artifact for deploy-helper/runbook changes.'
    printf '%s\n' '- Record rollback heads before any mutating promotion.'
  } >"$ARTIFACT_DIR/README.md"
}

write_local_evidence
write_remote_evidence
evaluate_gates
write_failures
write_metadata
write_summary

printf 'cmux review substrate evidence: %s\n' "$ARTIFACT_DIR"
if ((FAILURE_COUNT > 0)) && [[ "$ALLOW_DRIFT" != "true" ]]; then
  printf 'cmux review substrate deploy gates failed; see %s/gate-failures.txt\n' "$ARTIFACT_DIR" >&2
  exit 1
fi
