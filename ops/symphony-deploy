#!/usr/bin/env bash
set -euo pipefail

# symphony-deploy — pull, build, and restart symphony-ts on the server
# Usage: symphony-deploy [--dry-run] [--no-restart] [--symphony] [--config]

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
SYMPHONY_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Defaults — override via environment
CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/projects/claude-config}"
CTL="$SCRIPT_DIR/symphony-ctl"
LAUNCHD_RUNTIME_PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; NC='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; CYAN=''; NC=''
fi

info()  { echo -e "${CYAN}▸${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*" >&2; }
die()   { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

# --- Helpers ---

usage() {
  cat <<EOF
symphony-deploy — pull, build, and restart symphony-ts on the server

Usage: symphony-deploy [flags]

Flags:
  --dry-run       Show what each step would do without executing
  --no-restart    Pull and build but skip service restart
  --symphony      Only update symphony-ts repo
  --config        Only update claude-config repo

If neither --symphony nor --config is given, both are updated.

Environment:
  CLAUDE_CONFIG_DIR   Path to claude-config repo (default: ~/projects/claude-config)
  SYMPHONY_PROJECT    Project name for symphony-ctl (default: symphony)

EOF
}

# --- Flags ---

DRY_RUN=false
NO_RESTART=false
DO_SYMPHONY=false
DO_CONFIG=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)      DRY_RUN=true ;;
    --no-restart)   NO_RESTART=true ;;
    --symphony)     DO_SYMPHONY=true ;;
    --config)       DO_CONFIG=true ;;
    -h|--help)      usage; exit 0 ;;
    *)              die "Unknown flag: $1" ;;
  esac
  shift
done

# Default: both repos if neither specified
if ! $DO_SYMPHONY && ! $DO_CONFIG; then
  DO_SYMPHONY=true
  DO_CONFIG=true
fi

run_or_dry() {
  if $DRY_RUN; then
    info "[dry-run] $*"
  else
    "$@"
  fi
}

# write_build_stamp ROOT — record the git SHA the dist was just built from in
# dist/.build-sha, so a later same-SHA deploy can tell whether dist/ is current
# for HEAD independent of file mtimes (SYMPH-921). Best-effort: a no-op outside a
# git checkout. Call it after every successful build.
write_build_stamp() {
  local root="$1" sha
  sha="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
  if [[ -n "$sha" ]]; then
    printf '%s\n' "$sha" > "$root/dist/.build-sha"
  fi
}

# dist_is_stale ROOT — exit 0 (stale) when dist/ must be rebuilt even though the
# git SHA did not move; exit 1 (fresh) otherwise. Checks, in order:
#   1. compiled entrypoint missing                  -> stale
#   2. build-stamp missing or != HEAD (SYMPH-921)   -> stale: dist/ was not built
#      from the current checkout (external git advance, partial/failed build)
#   3. `find` unavailable (SYMPH-921)               -> stale: cannot prove
#      freshness, so fail safe toward a rebuild rather than skip on uncertainty
#   4. any src file newer than the entrypoint       -> stale: uncommitted edits
#   else                                            -> fresh
# Known limitation (SYMPH-921): arbitrary corruption of a NON-entry dist/ file at
# a matching SHA with older mtimes is not detected; full integrity would need a
# file manifest. The build-stamp + entrypoint + mtime checks cover the observed
# failure modes (external SHA advance, partial/failed build, deleted dist/).
# Extends the src->dist staleness guard in run-pipeline.sh (SYMPH-919).
dist_is_stale() {
  local root="$1"
  local dist_entry="$root/dist/src/cli/main.js"
  local stamp="$root/dist/.build-sha"
  if [[ ! -f "$dist_entry" ]]; then
    return 0
  fi
  local head_sha=""
  head_sha="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
  if [[ -n "$head_sha" ]]; then
    if [[ ! -f "$stamp" || "$(cat "$stamp" 2>/dev/null)" != "$head_sha" ]]; then
      return 0
    fi
  fi
  if ! command -v find >/dev/null 2>&1; then
    return 0
  fi
  # `command find` bypasses any shadowing shell function/alias named find.
  if [[ -n "$(command find "$root/src" -newer "$dist_entry" -type f 2>/dev/null)" ]]; then
    return 0
  fi
  return 1
}

# build_decision ROOT SHA_CHANGED — echo the symphony build-gate decision so the
# gate is behaviorally testable (SYMPH-921), separate from its side effects:
#   "code-changed"  the git SHA moved -> build (+ install if the lockfile changed)
#   "stale-dist"    SHA unchanged but dist/ is out of sync with HEAD -> rebuild
#                   (SYMPH-919)
#   "current"       dist/ is current -> skip
# Pure: no build, no install, no logs, no side effects. SHA_CHANGED is "true"/"false".
build_decision() {
  local root="$1" sha_changed="$2"
  if [[ "$sha_changed" == "true" ]]; then
    echo "code-changed"
  elif dist_is_stale "$root"; then
    echo "stale-dist"
  else
    echo "current"
  fi
}

restart_stopped_services_after_error() {
  # Restart after ordinary pull/build/config errors. Crabrunner review substrate
  # failures are deploy-time blockers only for workflows that explicitly opt in.
  warn "Deploy failed — restarting services..."
  "$CTL" start 2>/dev/null || true
  "$SLACK_CTL" start 2>/dev/null || true
}

# Check if symphony-ctl service is installed (plist exists)
service_installed() {
  [[ -f "$HOME/Library/LaunchAgents/com.symphony.${SYMPHONY_PROJECT:-symphony}.plist" ]]
}

trim_config_value() {
  sed -e 's/^[[:space:]]*//' \
      -e 's/[[:space:]]*$//' \
      -e 's/^"//' \
      -e 's/"$//' \
      -e "s/^'//" \
      -e "s/'$//"
}

dotenv_value() {
  local file="$1"
  local key="$2"
  local line

  [[ -f "$file" ]] || return 1

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(printf '%s\n' "$line" | trim_config_value)"
    case "$line" in
      "$key="*|"export $key="*)
        printf '%s\n' "${line#*=}" | trim_config_value
        return 0
        ;;
    esac
  done < "$file"

  return 1
}

deploy_config_value() {
  local key="$1"
  local env_file="${2:-}"

  if [[ -n "${!key+x}" ]]; then
    printf '%s\n' "${!key}"
    return 0
  fi

  if [[ -n "$env_file" ]]; then
    dotenv_value "$env_file" "$key" || true
  fi
}

resolve_symphony_workflow_path() {
  local env_file="${1:-}"
  local workflow_path
  local project

  workflow_path="$(deploy_config_value SYMPHONY_WORKFLOW "$env_file")"
  if [[ -z "$workflow_path" ]]; then
    project="$(deploy_config_value SYMPHONY_PROJECT "$env_file")"
    [[ -n "$project" ]] || project="symphony"
    workflow_path="$SYMPHONY_ROOT/pipeline-config/workflows/WORKFLOW-${project}.md"
  elif [[ "$workflow_path" != /* ]]; then
    workflow_path="$SYMPHONY_ROOT/$workflow_path"
  fi

  printf '%s\n' "$workflow_path"
}

workflow_enables_crabrunner_review() {
  local workflow_path="$1"
  [[ -f "$workflow_path" ]] || return 1

  awk '
    /^---[[:space:]]*$/ {
      if (!seen_frontmatter) {
        seen_frontmatter = 1
        in_frontmatter = 1
        next
      }
      if (in_frontmatter) {
        exit
      }
    }
    !in_frontmatter {
      next
    }
    /^review_execution:[[:space:]]*$/ {
      in_review_execution = 1
      in_crabrunner_group = 0
      next
    }
    /^[^[:space:]#][^:]*:[[:space:]]*$/ {
      in_review_execution = 0
      in_crabrunner_group = 0
      next
    }
    in_review_execution && /^  crabrunner_job_group:[[:space:]]*$/ {
      in_crabrunner_group = 1
      next
    }
    in_review_execution && /^  [^[:space:]#][^:]*:[[:space:]]*$/ {
      in_crabrunner_group = 0
      next
    }
    in_crabrunner_group && /^    enabled:[[:space:]]*true([[:space:]#].*)?$/ {
      found = 1
    }
    END {
      exit found ? 0 : 1
    }
  ' "$workflow_path"
}

run_crabrunner_review_preflight() {
  local env_file="${1:-}"
  local workflow_path
  local crabrunner_root
  local root_real
  local crabrunner_bin
  local bin_real

  workflow_path="$(resolve_symphony_workflow_path "$env_file")"
  if ! workflow_enables_crabrunner_review "$workflow_path"; then
    info "Crabrunner review preflight skipped (workflow does not enable crabrunner review)."
    return 0
  fi

  crabrunner_root="$(deploy_config_value SYMPHONY_CRABRUNNER_ROOT "$env_file")"
  if [[ -z "$crabrunner_root" ]]; then
    die "Crabrunner review preflight failed: the active workflow enables review_execution.crabrunner_job_group.enabled but SYMPHONY_CRABRUNNER_ROOT is not set. Set SYMPHONY_CRABRUNNER_ROOT to the Crucible checkout that owns bin/crabrunner, or disable review_execution.crabrunner_job_group.enabled in $workflow_path."
  fi

  if [[ ! -d "$crabrunner_root" ]]; then
    die "Crabrunner review preflight failed: SYMPHONY_CRABRUNNER_ROOT '$crabrunner_root' does not exist. Set it to the Crucible checkout that owns bin/crabrunner, or disable review_execution.crabrunner_job_group.enabled in $workflow_path."
  fi

  root_real="$(realpath "$crabrunner_root" 2>/dev/null)" || die "Crabrunner review preflight failed: could not resolve SYMPHONY_CRABRUNNER_ROOT '$crabrunner_root'."
  crabrunner_bin="$crabrunner_root/bin/crabrunner"

  if [[ ! -e "$crabrunner_bin" ]]; then
    die "Crabrunner review preflight failed: missing $crabrunner_bin. Set SYMPHONY_CRABRUNNER_ROOT to the Crucible checkout that owns bin/crabrunner, or disable review_execution.crabrunner_job_group.enabled in $workflow_path."
  fi

  bin_real="$(realpath "$crabrunner_bin" 2>/dev/null)" || die "Crabrunner review preflight failed: could not resolve $crabrunner_bin."
  case "$bin_real" in
    "$root_real"/*) ;;
    *)
      die "Crabrunner review preflight failed: $crabrunner_bin resolves outside SYMPHONY_CRABRUNNER_ROOT ($bin_real not under $root_real)."
      ;;
  esac

  if [[ ! -f "$bin_real" || ! -x "$bin_real" ]]; then
    die "Crabrunner review preflight failed: $crabrunner_bin must be an executable file."
  fi

  ok "Crabrunner review preflight passed ($bin_real)"
}

# Ensure the report-server launchd job is installed and loaded. It serves
# ~/.symphony/reports on :8090 (the BASE_URL host for the mobile dashboard and
# token reports). The plist is generated here with $HOME baked in — no hardcoded
# username — mirroring symphony-ctl's generate_plist. Idempotent; non-fatal.
# SYMPH-611
ensure_report_server() {
  local label="com.symphony.report-server"
  local plist="$HOME/Library/LaunchAgents/${label}.plist"
  local reports_dir="$HOME/.symphony/reports"
  local logs_dir="$HOME/.symphony/logs"
  local domain="gui/$(id -u)"

  if ! command -v launchctl >/dev/null 2>&1; then
    warn "launchctl not found — skipping report-server install"
    return 0
  fi

  local desired
  desired="$(cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by symphony-deploy (ensure_report_server). Static file server for
     HTML reports; serves \$HOME/.symphony/reports on port 8090. SYMPH-131 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>http.server</string>
        <string>8090</string>
        <string>--directory</string>
        <string>${reports_dir}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>${reports_dir}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/usr/sbin:/bin:/sbin</string>
        <key>HOME</key>
        <string>${HOME}</string>
    </dict>
    <key>StandardOutPath</key>
    <string>${logs_dir}/report-server-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>${logs_dir}/report-server-stderr.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
PLIST
)"

  run_or_dry mkdir -p "$reports_dir" "$logs_dir" "$(dirname "$plist")"

  local needs_write=false
  if [[ ! -f "$plist" ]] || ! printf '%s\n' "$desired" | cmp -s - "$plist"; then
    needs_write=true
  fi

  if $needs_write; then
    info "Installing report-server plist ($plist)..."
    if $DRY_RUN; then
      info "[dry-run] write $plist; reload $label"
      return 0
    fi
    printf '%s\n' "$desired" > "$plist"
    if $NO_RESTART; then
      ok "Report-server plist written (--no-restart: not (re)loading)"
      return 0
    fi
    launchctl bootout "$domain/$label" 2>/dev/null || true
    # Wait for the old process to release :8090 so the new one does not hit
    # EADDRINUSE and bounce off the KeepAlive throttle (a ~10s dashboard blip).
    local tries=0
    while lsof -nP -iTCP:8090 -sTCP:LISTEN >/dev/null 2>&1 && [[ $tries -lt 20 ]]; do
      sleep 0.25
      tries=$((tries + 1))
    done
    if launchctl bootstrap "$domain" "$plist"; then
      ok "Report server installed and loaded"
    else
      warn "Report-server bootstrap failed — check $logs_dir/report-server-stderr.log"
    fi
    return 0
  fi

  # Plist already current — make sure it is actually loaded.
  if launchctl print "$domain/$label" >/dev/null 2>&1; then
    ok "Report server already current and loaded"
  elif $NO_RESTART; then
    ok "Report-server plist current (--no-restart: not loading)"
  else
    info "Report-server plist current but not loaded — loading..."
    if launchctl bootstrap "$domain" "$plist"; then
      ok "Report server loaded"
    else
      warn "Report-server bootstrap failed — check $logs_dir/report-server-stderr.log"
    fi
  fi
}

get_version() {
  if [[ -x "$CTL" ]]; then
    "$CTL" --version 2>/dev/null || echo "(unknown)"
  else
    echo "(symphony-ctl not found)"
  fi
}

# --- Pull a git repo ---
# Arguments: repo_path repo_label
# Sets globals: _PRE_SHA _POST_SHA _LOCKFILE_CHANGED _ENV_ENC_CHANGED
pull_repo() {
  local repo_path="$1"
  local label="$2"

  info "Pulling $label ($repo_path)..."
  _PRE_SHA="$(git -C "$repo_path" rev-parse HEAD)"

  if $DRY_RUN; then
    info "[dry-run] git -C $repo_path pull --ff-only"
    _POST_SHA="$_PRE_SHA"
    _LOCKFILE_CHANGED=false
    _ENV_ENC_CHANGED=false
    return
  fi

  git -C "$repo_path" pull --ff-only || die "git pull --ff-only failed in $repo_path. Branches may have diverged — resolve manually."
  _POST_SHA="$(git -C "$repo_path" rev-parse HEAD)"

  if [[ "$_PRE_SHA" == "$_POST_SHA" ]]; then
    ok "$label already up to date (${_PRE_SHA:0:8})"
    _LOCKFILE_CHANGED=false
    _ENV_ENC_CHANGED=false
    return
  fi

  ok "$label updated: ${_PRE_SHA:0:8} → ${_POST_SHA:0:8}"

  # Check what changed between old and new SHA
  local changed_files
  changed_files="$(git -C "$repo_path" diff --name-only "$_PRE_SHA" "$_POST_SHA")"

  _LOCKFILE_CHANGED=false
  if echo "$changed_files" | grep -q '^pnpm-lock\.yaml$'; then
    _LOCKFILE_CHANGED=true
  fi

  _ENV_ENC_CHANGED=false
  if echo "$changed_files" | grep -q '^\.env\.enc$'; then
    _ENV_ENC_CHANGED=true
  fi
}

# --- Main ---

if $DRY_RUN; then
  info "symphony-deploy [DRY RUN]"
else
  info "symphony-deploy"
fi
echo ""

NEED_ENV_RESTART=false
NEED_SERVICE_REINSTALL=false
SYMPHONY_UPDATED=false
SYMPH_PRE_SHA=""
SYMPH_POST_SHA=""

# --- 1. Symphony-ts repo ---
if $DO_SYMPHONY; then
  info "=== symphony-ts ==="
  [[ -d "$SYMPHONY_ROOT/.git" ]] || die "Not a git repo: $SYMPHONY_ROOT"

  # Pre-deploy version
  info "Pre-deploy version: $(get_version)"

  # Stop services before updating to prevent reading mixed old/new files
  # (git pull changes templates/configs while service is running from this directory)
  SLACK_CTL="$SCRIPT_DIR/slack-bridge-ctl"
  SLACK_PLIST="$HOME/Library/LaunchAgents/com.slack-bridge.plist"
  SERVICES_STOPPED=false

  if ! $NO_RESTART && service_installed; then
    info "Stopping service before update..."
    run_or_dry "$CTL" stop
    ok "Service stopped"
    SERVICES_STOPPED=true
  fi

  if ! $NO_RESTART && [[ -x "$SLACK_CTL" ]] && [[ -f "$SLACK_PLIST" ]]; then
    info "Stopping slack bridge before update..."
    run_or_dry "$SLACK_CTL" stop
    ok "Slack bridge stopped"
    SERVICES_STOPPED=true
  fi

  # Restart services if the script fails mid-deploy (set -e would leave them down)
  if $SERVICES_STOPPED && ! $DRY_RUN; then
    trap 'restart_stopped_services_after_error' ERR
  fi

  # Ensure clean checkout to main — stash uncommitted changes if needed
  current_branch=""
  current_branch="$(git -C "$SYMPHONY_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

  if [[ "$current_branch" != "main" ]]; then
    info "On branch '$current_branch' — switching to main..."

    if ! $DRY_RUN; then
      if ! git -C "$SYMPHONY_ROOT" diff --quiet 2>/dev/null || \
         ! git -C "$SYMPHONY_ROOT" diff --cached --quiet 2>/dev/null; then
        stash_msg="symphony-deploy auto-stash $(date +%Y%m%d-%H%M%S) from $current_branch"
        git -C "$SYMPHONY_ROOT" stash push -m "$stash_msg"
        warn "Stashed uncommitted changes: $stash_msg"
      fi
    fi
  fi

  run_or_dry git -C "$SYMPHONY_ROOT" checkout main || die "Failed to checkout main. Run 'git -C $SYMPHONY_ROOT stash list' to check for auto-stashed changes."

  pull_repo "$SYMPHONY_ROOT" "symphony-ts"
  SYMPH_PRE_SHA="$_PRE_SHA"
  SYMPH_POST_SHA="$_POST_SHA"

  SYMPH_SHA_CHANGED=false
  [[ "$SYMPH_PRE_SHA" != "$SYMPH_POST_SHA" ]] && SYMPH_SHA_CHANGED=true

  case "$(build_decision "$SYMPHONY_ROOT" "$SYMPH_SHA_CHANGED")" in
    code-changed)
      SYMPHONY_UPDATED=true

      # pnpm install if lockfile changed
      if $_LOCKFILE_CHANGED; then
        info "pnpm-lock.yaml changed — installing dependencies..."
        run_or_dry pnpm install --frozen-lockfile --dir "$SYMPHONY_ROOT"
        ok "Dependencies installed"
      else
        ok "pnpm-lock.yaml unchanged — skipping install"
      fi

      # Always rebuild if code changed
      info "Building..."
      run_or_dry pnpm run --dir "$SYMPHONY_ROOT" build
      run_or_dry write_build_stamp "$SYMPHONY_ROOT"
      ok "Build complete"
      ;;
    stale-dist)
      # SYMPH-919: the SHA did not move but dist/ is out of sync with HEAD. The
      # pipeline runs from compiled dist/, so restarting now would run stale
      # code. Rebuild instead of silently skipping. No install — the lockfile
      # cannot have changed without a SHA move.
      SYMPHONY_UPDATED=true
      warn "dist/ stale at unchanged SHA ${SYMPH_POST_SHA:0:8} — rebuilding..."
      run_or_dry pnpm run --dir "$SYMPHONY_ROOT" build
      run_or_dry write_build_stamp "$SYMPHONY_ROOT"
      ok "Build complete (refreshed stale dist/)"
      ;;
    current)
      ok "dist/ current at ${SYMPH_POST_SHA:0:8} — skipping rebuild"
      ;;
  esac

  # Sync mobile dashboard to report server directory
  dashboard_src="$SYMPHONY_ROOT/.symphony/reports/mobile-dashboard.html"
  reports_dir="$HOME/.symphony/reports"
  if [[ -f "$dashboard_src" ]]; then
    if ! cmp -s "$dashboard_src" "$reports_dir/index.html" 2>/dev/null; then
      info "Syncing mobile dashboard to report server..."
      run_or_dry mkdir -p "$reports_dir"
      run_or_dry cp "$dashboard_src" "$reports_dir/index.html"
      run_or_dry cp "$dashboard_src" "$reports_dir/mobile-dashboard.html"
      ok "Dashboard synced (index.html + mobile-dashboard.html)"
    else
      ok "Mobile dashboard already current"
    fi
  fi

  # Ensure the report-server launchd job that serves the dashboard is running
  ensure_report_server

  # Decrypt .env.enc if it's newer than .env
  local_env="$SYMPHONY_ROOT/.env"
  local_enc="$SYMPHONY_ROOT/.env.enc"
  if [[ -f "$local_enc" ]]; then
    if [[ ! -f "$local_env" ]] || [[ "$local_enc" -nt "$local_env" ]]; then
      info ".env.enc is newer than .env — decrypting..."
      if $DRY_RUN; then
        info "[dry-run] sops --decrypt --input-type dotenv --output-type dotenv $local_enc > $local_env"
      else
        sops --decrypt --input-type dotenv --output-type dotenv "$local_enc" > "$local_env"
      fi
      ok ".env decrypted"
      NEED_ENV_RESTART=true
    else
      ok ".env is current — skipping decrypt"
    fi
  fi

  run_crabrunner_review_preflight "$local_env"

  if [[ -f "$local_env" ]]; then
    info "Using service environment from .env; review/QA runs through crabrunner when configured."
    if $NEED_ENV_RESTART && ! $NO_RESTART && service_installed; then
      NEED_SERVICE_REINSTALL=true
    fi
  else
    warn ".env not found — skipping service environment refresh"
  fi

  # Prune stale branches (squash-merged PRs leave local refs behind)
  if [[ -x "$CTL" ]]; then
    info "Pruning stale branches..."
    if $DRY_RUN; then
      run_or_dry "$CTL" prune-branches --dry-run
    else
      "$CTL" prune-branches --execute 2>&1 | sed 's/^/  /'
    fi
  fi

  echo ""
fi

# --- 2. Claude-config repo ---
if $DO_CONFIG; then
  info "=== claude-config ==="

  if [[ ! -d "$CLAUDE_CONFIG_DIR" ]]; then
    warn "claude-config dir not found at $CLAUDE_CONFIG_DIR — skipping"
  elif [[ ! -d "$CLAUDE_CONFIG_DIR/.git" ]]; then
    warn "$CLAUDE_CONFIG_DIR is not a git repo — skipping"
  else
    pull_repo "$CLAUDE_CONFIG_DIR" "claude-config"
    CONFIG_PRE_SHA="$_PRE_SHA"
    CONFIG_POST_SHA="$_POST_SHA"

    # Apply config changes (symlinks skills, CLAUDE.md, RTK.md, merges settings.json)
    if [[ -x "$CLAUDE_CONFIG_DIR/deploy.sh" ]]; then
      info "Applying claude-config..."
      run_or_dry "$CLAUDE_CONFIG_DIR/deploy.sh"
      ok "claude-config applied"
    fi
  fi

  echo ""
fi

# --- 3. Service start (services were stopped before git pull) ---
if ! $NO_RESTART && $DO_SYMPHONY; then
  info "=== Service ==="

  if ! service_installed; then
    info "Service not installed — skipping"
  elif $NEED_ENV_RESTART || $NEED_SERVICE_REINSTALL; then
    # Reinstall so launchd sees the same .env file deploy just refreshed.
    info "Reinstalling service (plist bakes validated env vars)..."
    run_or_dry "$CTL" uninstall
    run_or_dry "$CTL" install
    run_or_dry "$CTL" start
    ok "Service reinstalled and started"
  else
    info "Starting service..."
    run_or_dry "$CTL" start
    ok "Service started"
  fi

  echo ""
fi

# --- 3b. Slack bridge start ---
if ! $NO_RESTART && $DO_SYMPHONY; then
  if [[ ! -x "$SLACK_CTL" ]]; then
    info "slack-bridge-ctl not found — skipping"
  elif [[ ! -f "$SLACK_PLIST" ]]; then
    info "Slack bridge not installed — skipping"
  elif $NEED_ENV_RESTART; then
    info ".env was refreshed — reinstalling slack bridge..."
    run_or_dry "$SLACK_CTL" uninstall
    run_or_dry "$SLACK_CTL" install
    run_or_dry "$SLACK_CTL" start
    ok "Slack bridge reinstalled and started"
  else
    info "Starting slack bridge..."
    run_or_dry "$SLACK_CTL" start
    ok "Slack bridge started"
  fi

  echo ""
fi

# --- 4. Summary ---
info "=== Summary ==="

if $DO_SYMPHONY; then
  printf "  symphony-ts:   %s → %s\n" "${SYMPH_PRE_SHA:0:8}" "${SYMPH_POST_SHA:0:8}"
  info "Post-deploy version: $(get_version)"
fi

if $DO_CONFIG; then
  if [[ -n "${CONFIG_PRE_SHA:-}" ]]; then
    printf "  claude-config: %s → %s\n" "${CONFIG_PRE_SHA:0:8}" "${CONFIG_POST_SHA:0:8}"
  else
    printf "  claude-config: (skipped)\n"
  fi
fi

if $DRY_RUN; then
  echo ""
  info "Dry run complete — no changes were made."
fi
